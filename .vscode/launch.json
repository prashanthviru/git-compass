{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Git Compass",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"]
    },
    {
      "name": "Run Git Compass (other extensions disabled)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--disable-extensions"]
    }
  ]
}
